# Backend API base URL for Frontend build (Vite environment variable)
# If frontend & backend share the same domain/subdomain via Nginx reverse proxy:
# VITE_API_URL=/api
#
# If backend is on a separate subdomain (e.g. api.yourdomain.com):
# VITE_API_URL=https://api.yourdomain.com/api
#
# Local Development:
# VITE_API_URL=http://localhost:5004/api
VITE_API_URL=/api
